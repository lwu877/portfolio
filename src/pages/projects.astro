---
import Layout from '../layouts/Layout.astro';
import Grid from '../components/grid.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
}

const stuff = (await getCollection('projects')).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
---

<Layout
  description="Projects from a person that goes on too many side quests."
  title="Work and Projects · Lex Wu"
>
  <div class="py-8 gap-8">
    <h1 class="text-center text-4xl font-bold font-display">Works and Projects</h1>
    <p class="text-center py-4">Projects from a person that goes on too many side quests.</p>
  </div>
  <!-- Hero -->

  <section class="grid md:grid-cols-2 mx-auto max-w-2xl px-4 items-stretch content-stretch align-center md:max-w-7xl gap-8 lg:px-8 gap-x-8 gap-y-8">
    {
      stuff.map((stuff) => (

      <div class="grid lg:grid-cols-3 gap-8 px-8 py-8 bg-sky-100 dark:bg-sky-400/10 rounded-3xl">
        <div>
          <img src={stuff.data.img} alt={stuff.data.imgalt} class="mx-auto rounded-t-2xl object-cover" />
          <p class="px-2 py-2 rounded-b-2xl bg-slate-700 text-center">{stuff.data.status}</p>
        </div>

        
        <div class="self-center col-span-2 gap-4 grid">
          <h2 class="text-3xl font-semibold font-display">{stuff.data.title}</h2>
          <p>{stuff.data.description}</p>

          {stuff.data.clm == true && (
                <span class="text-sm">a <a class="font-display" href="https://curtainlorimer.com">curtain lorimer</a> project</span>
              )}
          <div class="gap-4 flex"> 
            <a class="button no-underline text-white bg-primary-700" href={`/projects/${stuff.id}`}>project info</a>
            {stuff.data.extlinkpresent == true && (
               <a class="button no-underline text-white bg-primary-700" href={stuff.data.extlink}>visit ite</a> 
              )}
          </div>
          
        </div>
      </div>

      ))
    }
  </section>
  <Grid>

  </Grid>
</Layout>
