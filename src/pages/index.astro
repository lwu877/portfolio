---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { CollectionEntry, getCollection } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const stuff = (await getCollection('projects', ({ data }) => { return data.current !== true; })).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
).slice(0, 3);

const currentstuff = (await getCollection('projects', ({ data }) => { return data.current == true; }));
---

<Layout
  description="A musician who does too much other stuff."
  title="Lex Wu"
>

  <section class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 mx-auto max-w-2xl px-4 items-stretch content-stretch align-center lg:max-w-7xl gap-8 lg:px-8 gap-x-8 gap-y-8 py-8 ">

    <div class="size-auto aspect-video rounded-3xl col-span-1 md:col-span-2 lg:col-span-3">
      <Image class="aspect-video rounded-3xl object-cover" width="1280" height="640" src="/assets/outside-pfp.jpg" alt="Lex Wu" loading="eager"/>
    </div>

    <div class="bg-blue-500/25 dark:bg-blue-400/10 gap-8 rounded-3xl px-4 py-4 sm:gap-10 flex md:col-span-2">
      <div class="flex max-w-xl flex-col items-start gap-4 sm:gap-6">
        <h1 class="text-3xl font-medium sm:text-5xl lg:text-6xl">
          Hey, I'm Lex 👋
        </h1>
        <p class="text-primary-950/70 dark:text-primary-200/70 text-lg sm:text-xl">
          Coder, journalist, designer, and musician. I create things that make the world a better place.
        </p>
      </div>
    </div>


  <div class="bg-purple-600/20 dark:bg-purple-500/20 text-center gap-8 rounded-3xl px-4 py-4 justify-center sm:gap-10 flex items-center">
    <a class="no-underline" href="https://lwumusic.com">
      <div class="gap-4 sm:gap-6 self-center">
        <p class="mx-auto max-w-2xl text-lg self-center">
          You might know me from my music - which is on a different site now.
        </p>
        <br>
        <p>→</p>
      </div>
    </a>
  </div>

    <div class="bg-[#212121] flex flex-col items-center gap-8 rounded-3xl px-4 py-4">
      <div class="flex flex-col gap-4 sm:gap-6">
        <a href="https://www.last.fm/user/lwu877"><img src="https://lastfm-recently-played.vercel.app/api?user=lwu877" height="auto" width="350px"/></a>
      </div>
    </div>

    <div class="bg-blue-500/25 dark:bg-blue-400/10 gap-8 rounded-3xl px-4 py-4 sm:gap-10 flex">
      <div class="flex max-w-xl flex-col items-start gap-4 sm:gap-6">
        <h2 class="text-3xl font-medium sm:text-5xl lg:text-6xl">
          Social?
        </h2>
        <p>I sure try to be!</p>
        <div class="justify-center flex gap-4">
          <a class="no-underline" href="https://instagram.com/lwu877"><p class="no-underline text-white text-md bg-blue-600 dark:bg-blue-700 hover:bg-blue-800 dark:hover:bg-blue-900 px-4 py-4 rounded-full w-full place-self-center">Instagram</p></a>
          <a class="no-underline" href="https://bsky.app/profile/lexwu.com"><p class="no-underline text-white text-md bg-blue-600 dark:bg-blue-700 hover:bg-blue-800 dark:hover:bg-blue-900 px-4 py-4 rounded-full w-full place-self-center">Bluesky</p></a>
        </div>

        <!-- Github Profile Badge -->
        <div class="github-profile-badge" data-user="lwu877"> </div>
        <script src="https://cdn.jsdelivr.net/gh/Rapsssito/github-profile-badge@latest/src/widget.min.js"></script>
      </div>
    </div>

    <div class="bg-[#212325] rounded-3xl row-span-2">
      <h2 class="py-4 font-semibold text-xl text-center text-white">Events</h2>
      <div class="min-h-[450px] h-[80%]">
        <iframe
          class="px-4 py-4"
          src="https://lu.ma/embed/calendar/cal-qOiFHDZcKuM6P7x/events?lt=dark"
          height="100%"
          width="100%"
          frameborder="0"
          allowfullscreen=""
          aria-hidden="false"
          tabindex="0"
        ></iframe>
      </div>
    </div>


    <div class="bg-blue-500/25 dark:bg-blue-400/10 gap-8 rounded-3xl px-4 py-4 sm:gap-10 flex md:col-span-2">
      <div class="flex max-w-xl flex-col items-start gap-4 sm:gap-6">
        <h2 class="text-3xl font-medium sm:text-5xl lg:text-6xl">
          Here's what I'm doing right now
        </h2>
        <p class="text-primary-950/70 dark:text-primary-200/70 text-lg sm:text-xl">
          It's a lot, I know.
        </p>
      </div>
    </div>
  </section>

  <section class="grid lg:grid-cols-3 grid-cols-2 mx-auto max-w-2xl px-4 items-stretch content-stretch align-center lg:max-w-7xl gap-8 lg:px-8 gap-x-8 gap-y-8">
    {
      currentstuff.map((curstuff) => (

        <div class="bg-blue-500/25 dark:bg-blue-400/10 flex flex-col items-start gap-8 sm:gap-10 rounded-3xl px-4 py-4 text-center content-stretch place-items-start mx-auto">
          <div class="flex flex-col gap-4 sm:gap-6">
            <a class="no-underline" href={`/projects/${curstuff.id}`}>
              <img src={curstuff.data.img} alt={curstuff.data.imgalt} class="rounded-2xl hover:rounded-3xl aspect-square object-cover transition transform hover:scale-110 transition-duration-50 transition-ease-in-out" />
              <h2 class="mx-auto max-w-3xl text-3xl font-medium py-8">{curstuff.data.title}</h2>
              <p>{curstuff.data.description}</p>
            </a>
            <div class="justify-center">
              <a class="no-underline" href={curstuff.data.extlink}><p class="no-underline text-white text-md bg-blue-600 dark:bg-blue-700 hover:bg-blue-800 dark:hover:bg-blue-900 px-4 py-4 rounded-full w-full place-self-center">Visit Site</p></a>
            </div>
          </div>

        </div>

      ))
    }
  </section>

  <section class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 mx-auto max-w-2xl px-4 items-stretch content-stretch align-center lg:max-w-7xl gap-8 lg:px-8 gap-x-8 gap-y-8 py-8 ">

    <div class="bg-blue-500/25 dark:bg-blue-400/10 gap-8 rounded-3xl px-4 py-4 sm:gap-10 flex md:col-span-2">
      <a class="no-underline" href="/projects">
          <div class="flex flex-col items-start gap-4 sm:gap-6">
            <h2 class="text-2xl font-medium sm:text-4xl lg:text-5xl">
              There's more where that came from
            </h2>
            <p class="text-primary-950/70 dark:text-primary-200/70 text-lg sm:text-xl">
              In addition to those projects, I've worked on a lot of of other things too →
            </p>
          </div>
      </a>
    </div>

  </section>



</Layout>
