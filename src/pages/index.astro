---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import pfp from '../assets/pfp.png';
import music from '../assets/photography/memorial-bridge.jpg';
import journalism from '../assets/photography/flower.jpg';
import photography from '../assets/photography/otamatone.jpg';
---

<Layout
  description="A musician who does too much other stuff."
  title="Lex Wu"
>

  <section class="grid lg:grid-cols-3 max-w-7xl mx-auto px-4 items-stretch content-stretch align-center gap-8 lg:px-8 gap-x-8 gap-y-8 pt-8">

    <div class="size-auto">
      <Image class="rounded-3xl" width="1080" src={pfp} alt="Lex Wu" loading="eager"/>
    </div>

    <div class="bg-emerald-100 dark:bg-emerald-800/25 gap-8 rounded-3xl px-4 py-4 sm:gap-10 flex md:col-span-2">
      <div class="flex max-w-xl flex-col items-start gap-4 sm:gap-6">
        <h1 class="text-3xl font-medium sm:text-5xl lg:text-6xl font-display">
          Hey, I'm Lex 👋
        </h1>
        <p class="text-lg sm:text-xl">
          I'm a journalist, coder, photographer, videographer, and a multimedia specialist who's always looking for another project to work on.
        </p>
        <p class="text-lg sm:text-xl">
          I currently do the following things if you wanna learn more about me:
        </p>
      </div>
    </div>
  </section>

  <section class="grid lg:grid-cols-2 max-w-7xl mx-auto px-4 items-stretch content-stretch align-center gap-8 lg:px-8 gap-x-8 gap-y-8 pt-8 ">
    <div class="relative w-full h-64 rounded-3xl hover:scale-105 duration-100 overflow-hidden">
      <a href="/music">
      <Image class="absolute inset-0 w-full h-full object-cover" width="1920" loading="eager" src={music} alt="Memorial Bridge" />
      <div class="absolute inset-0 bg-linear-to-t from-black/75 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-4">
        <h2 class="text-white text-lg font-semibold">Music</h2>
        <p class="text-white">I perform under the starryquay and lwumusic monikers.</p>
      </div>
      </a>
    </div>

    <div class="relative w-full h-64 lg:row-span-2 lg:h-136 rounded-3xl hover:scale-105 duration-100 overflow-hidden">
      <a href="/journalism">
        <Image class="absolute inset-0 w-full h-full object-cover" width="1280" loading="eager" src={journalism} alt="Flower" />
        <div class="absolute inset-0 bg-linear-to-t from-black/75 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-4">
          <h2 class="text-white text-lg font-semibold">Journalism</h2>
          <p class="text-white">Telling unique stories that entertain, educate, and inform.</p>
        </div>
      </a>
    </div>

    <div class="relative w-full h-64 rounded-3xl hover:scale-105 duration-100 overflow-hidden">
      <a href="/photography">
        <Image class="absolute inset-0 w-full h-full object-cover" loading="eager" width="1280" src={photography} alt="Otamatone" />
        <div class="absolute inset-0 bg-linear-to-t from-black/75 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-4">
          <h2 class="text-white text-lg font-semibold">Photography</h2>
          <p class="text-white">Event and nature photography, all in one</p>
        </div>
      </a>
    </div>
  </section>


</Layout>
