---
import Layout from '../layouts/Layout.astro';
import Grid from '../components/grid.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'organizations'>;
}

const stuff = (await getCollection('organizations')).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
---

<Layout
  description="Places where I've left my mark."
  title="Organizations · Lex Wu"
>
  <div class="py-8 gap-8">
    <h1 class="text-center text-4xl font-bold">Organizations</h1>
    <p class="text-center py-4">Places where I've left my mark.</p>
  </div>
  <!-- Hero -->

  <section class="grid lg:grid-cols-2 mx-auto max-w-2xl px-4 items-stretch content-stretch align-center lg:max-w-7xl gap-8 lg:px-8 gap-x-8 gap-y-8">
    {
      stuff.map((stuff) => (

      <div class="grid md:grid-cols-3 gap-8 px-8 py-8 bg-sky-100 dark:bg-sky-400/10 rounded-3xl">
        <img src={stuff.data.img} alt={stuff.data.imgalt} class="mx-auto rounded-2xl object-cover h-full" />
        
        <div class="self-center col-span-2 gap-4 grid">
          <h2 class="md:text-4xl text-3xl font-semibold font-display">{stuff.data.title}</h2>
                <span class="text-sm">{stuff.data.association}</span>
          <p>{stuff.data.description}</p>
          <div class="gap-4 md:flex grid"> 
            {stuff.data.pagegen == !false && (
              <a class="button no-underline text-white bg-primary-700" href={`/organizations/${stuff.id}`}>organization info</a>
              )}
            {stuff.data.extlinkpresent == true && (
               <a class="button no-underline text-white bg-primary-700" href={stuff.data.extlink}>visit site</a> 
              )}
          </div>
          
        </div>
      </div>

      ))
    }
  </section>

  <Grid>

  </Grid>
</Layout>
