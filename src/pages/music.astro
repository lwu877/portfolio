---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import pfp from '../assets/pfp.png';
---

<Layout
  description="Take a look at all of the work Lex Wu has done with music in the professional world."
  title="Music · Lex Wu"
>

  <section class="grid lg:grid-cols-2 max-w-7xl mx-auto px-4 items-stretch content-stretch align-center gap-8 lg:px-8 gap-x-8 gap-y-8 pt-8 ">

    <div class="bg-emerald-100 dark:bg-emerald-800/25 gap-8 rounded-3xl px-4 py-4 sm:gap-10 flex md:col-span-2">
      <div class="flex w-full flex-col items-start gap-4 sm:gap-6">
        <h1 class="text-3xl font-medium sm:text-5xl lg:text-6xl font-display">
          Music
        </h1>
        <p class="text-slate-950/70 dark:text-slate-200/70 text-lg sm:text-xl">
          Two different names, two very different worlds.
        </p>
      </div>
    </div>
  </section>
  <section class="grid lg:grid-cols-2 max-w-7xl mx-auto px-4 items-stretch content-stretch align-center gap-8 lg:px-8 gap-x-8 gap-y-8 py-8 ">
    <div class="bg-violet-100 dark:bg-violet-800/25 gap-8 rounded-3xl sm:gap-10 flex">
      <div class="flex max-w-xl flex-col items-start gap-4 sm:gap-6 px-4 py-4">
        <h2 class="text-3xl font-medium sm:text-5xl lg:text-6xl font-display">
          lex wu
        </h2>
        <p class="text-slate-950/70 dark:text-slate-200/70 text-lg sm:text-xl">
          The instrumental side of me. I regularly produce soundtracks for short films, series, and other media projects.
        </p>
        <a href="https://lwumusic.com" class="bg-violet-300 dark:bg-violet-800 button">main site</a>
      </div>
    </div>
    <div class="rounded-3xl overflow-hidden">
      <iframe data-testid="embed-iframe" style="border-radius:12px" src="https://open.spotify.com/embed/artist/6h2oR4XbwGdfhevDSo1o5w?utm_source=generator&theme=0&si=12b5c3b2b51f4f1d" width="100%" height="352" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
    </div>
    <!--
    <div class="rounded-3xl overflow-hidden lg:col-span-2">
      <div style="height: 100%; width: 100%;"><iframe src="https://audio.com/embed/audio/1851283506916505?theme=image" style="display:block; border-radius: 1px; border: none; height: 204px; width: 100%;"></iframe></div>
    </div> -->
    <div>
      <Image class="rounded-3xl object-cover aspect-video" width="1920" src={pfp} alt="Lex Wu" loading="eager"/>
    </div>
    <div class="bg-sky-100 dark:bg-sky-800/25 gap-8 rounded-3xl px-4 py-4 sm:gap-10 flex">
      <div class="flex max-w-xl flex-col items-start gap-4 sm:gap-6">
        <h2 class="text-3xl font-medium sm:text-5xl lg:text-6xl font-display">
          starryquay
        </h2>
        <p class="text-slate-950/70 dark:text-slate-200/70 text-lg sm:text-xl">
          The vocalist and storytelling side of me. I write songs about experiences, emotions, and stories that resonate with people, right at the corner of indie pop and electronic music.
        </p>
        <a href="https://starryquay.com" class="bg-sky-300 dark:bg-sky-800 button">main site</a>
      </div>
    </div>

  </section>


</Layout>
