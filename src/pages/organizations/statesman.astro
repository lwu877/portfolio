---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'statesman'>;
}

const stuff = (await getCollection('statesman')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);


---

<Layout
  description="News reporter, investigative journalism, and stories oh my"
  title="The Statesman · Lex Wu"
>

<div class="bg-sky-100 dark:bg-sky-950/25 pb-8 rounded-br-xl rounded-bl-xl">
  <section class="py-8 text-center align-center">
    <div class="mx-auto max-w-full text-center px-8">
      <div class="bg-white dark:bg-sky-950 flex flex-col items-center gap-8 rounded-3xl px-5 py-16 sm:gap-10">
        <div class="flex flex-col gap-4 sm:gap-6">
          <h1 class="text-4xl font-medium tracking-tight sm:text-5xl lg:text-6xl font-display">
            The Statesman
          </h1>
          <p class="text-primary-950/70 dark:text-primary-200/70 text-lg sm:text-xl">
            News reporter, investigative journalism, and stories oh my
          </p>
        </div>
      </div>
    </div>
  </section>
</div>
  <div class="max-w-2xl mx-auto  text-primary-950 dark:text-primary-100 flex flex-col items-center gap-8 rounded-3xl px-5 pt-16 sm:gap-10">
    <div class="flex flex-col gap-4 sm:gap-6">
      <p>
        I've written a few stories for the Statesman, including some on local events and issues. Right now, I'm currently working on some investigative pieces and other news stories. Here's just a few stories I've worked on.
      </p>
    </div>
  </div>


</section>
<h2 class="max-w-2xl lg:max-w-7xl w-full mx-auto text-center py-8 text-4xl font-display">Stories I've Written</h2>

  <section class="grid justify-center md:grid-cols-2 gap-8 mx-auto max-w-2xl px-4 text-center items-start content-stretch align-center lg:max-w-7xl lg:px-8 gap-x-8 gap-y-8">
    
  {
    stuff.map((stuff) => (

    <div class="bg-sky-500/10 dark:bg-sky-400/10 flex flex-col items-start gap-8 rounded-3xl justify-center px-4 py-4">
        <div class="flex flex-col gap-4 sm:gap-6">
          <a href={stuff.data.guid.rendered} class="no-underline hover:underline">
          <h3 class="mx-auto text-[#000] dark:text-[#fff] font-display text-3xl">{stuff.data.title.rendered}</h2>
          </a>
          <p class="">{stuff.data.excerpt.rendered.replace('</p>', '').replace('<p>','').replace('&#8230;','...').substring(0,200) + '...'}</p>
          <span class="text-xs px-4 w-fit mx-auto">published {stuff.data.date.getMonth()}/{stuff.data.date.getDate()}/{stuff.data.date.getFullYear()}</span>
        </div>
    </div>

    ))
  }

</section>

</Layout>

<style>
  h3 {
    font-weight: 600;
    font-size: 1.5rem;
    color: black;
  }

  p {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 1.125rem; /* 1.125rem (18px) */ 
    line-height: var(--text-lg--line-height); /* calc(1.75 / 1.125) */
  }
  
  ul {
    list-style-type: disc;
    margin-left: 1.5rem; /* 24px */
  }
</style>