---
const bottomLinks = [
  {
    header: 'Social',
    links: [
      {
        name: 'Bluesky',
        href: 'https://bsky.app/profile/lexwu.com',
        isExternal: true,
      },
      {
        name: 'Instagram',
        href: 'https://instagram.com/lwu877',
        isExternal: true,
      },
      {
        name: 'TikTok',
        href: 'https://tiktok.com/@lwu877',
        isExternal: true,
      },
      {
        name: 'YouTube',
        href: 'https://youtube.com/lwu877',
        isExternal: true,
      },
      {
        name: 'Github',
        href: 'https://github.com/lwu877',
        isExternal: true,
      },
    ],
  },
  {
    header: 'Ventures',
    links: [
      {
        name: 'Music',
        href: '/music',
        isExternal: false,
      },
      {
        name: 'Photography',
        href: '/photography',
        isExternal: false,
      },
      {
        name: 'Journalism',
        href: '/journalism',
        isExternal: false,
      },
      {
        name: 'Audio',
        href: '/audio',
        isExternal: false,
      }
    ],
  },
  {
    header: 'About Me',
    links: [
      {
        name: 'Home',
        href: '/',
        isExternal: false,
      },
      {
        name: 'About',
        href: '/about',
        isExternal: false,
      },
      {
        name: 'Contact',
        href: '/contact',
        isExternal: false,
      },
    ],
  },
  {
    header: 'Other Ventures',
    links: [
      {
        name: 'In Progress',
        href: 'https://inprogress.lexwu.com',
        isExternal: true,
      },
      {
        name: 'lwumusic',
        href: 'https://lwumusic.com',
        isExternal: true,
      },
      {
        name: 'starryquay',
        href: 'https://starryquay.com',
        isExternal: true,
      },
      {
        name: 'Curtain Lorimer',
        href: 'https://curtainlorimer.com',
        isExternal: true,
      },
    ],
  },
];

import '@fontsource-variable/geist'
---

<footer
  class="bg-emerald-100 dark:bg-emerald-950 mt-16 py-16 lg:mt-20 lg:py-20"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col justify-between gap-12 sm:gap-16 lg:flex-row">
      <div class="flex max-w-sm flex-col items-start gap-6 sm:gap-8">
        <img
          class="h-8 w-auto"
          width="65"
          height="40"
          :src="$store.theme.isDark ? '/assets/lwu-whitecon.svg' : '/assets/lwu-blackcon.svg'"
          alt="Lex Wu - Logo"
          loading="lazy"
        />
        <p class="text-primary-950/70 dark:text-primary-200/70 text-base">
          "Quite possibly one of the least average people you'll ever meet."
        </p>
        <p class="text-primary-950/70 dark:text-primary-200/70 text-sm">© 2026 Lex Wu / all rights reserved <br> <br>
          <span class="underline"><a href="/privacy">Privacy Policy</a></span> / <span class="underline"><a href="/licenses.txt">Licenses</a></span>
        </p>
      </div>

      <!-- Bottom links -->
      <div class="grid max-w-xl flex-1 grid-cols-1 gap-8 sm:grid-cols-3">
        <style>
          li {
            list-style-type: none;
          }
          a {
            text-decoration: none;
          }
          a:hover {
            font-weight: 600;
            text-decoration: none;
          }
        </style>
        {
          bottomLinks.map((group) => (
            <div class="flex flex-col gap-4">
              <p class="text-base font-medium font-display">{group.header}</p>
              <ul role="list" class="flex flex-col gap-3">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="focus-visible:outline-primary-950 dark:focus-visible:outline-primary-200 inline-flex items-center gap-1 rounded-md text-base hover:underline focus-visible:outline focus-visible:outline-2"
                      target={link.isExternal ? '_blank' : undefined}
                      rel={link.isExternal ? 'noopener' : undefined}
                    >
                      {link.name}
                      {link.isExternal && (
                        <svg
                          class="h-4 w-4"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                          loading="lazy"
                        >
                          <path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z" />
                        </svg>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</footer>
